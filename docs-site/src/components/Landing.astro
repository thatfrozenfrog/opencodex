---
// English landing page. Liquid Editorial composition:
// type-led centered hero, provider pill chips as content, product-as-stage
// media band, quickstart terminal, bento feature slab, docs link row.
// Styling lives in src/styles/custom.css under the `.lp` namespace.
import { Image } from 'astro:assets';
import {
	siAnthropic,
	siApple,
	siDeepseek,
	siGoogle,
	siGithub,
	siLinux,
	siMoonshotai,
	siOllama,
	siOpenrouter,
} from 'simple-icons';
import demo from '../assets/demo.gif';
import dashboard from '../assets/dashboard.png';
import picker from '../assets/codex-app-picker.png';
import heroFieldLight from '../assets/hero-route-light.png';
import heroFieldDark from '../assets/hero-route-dark.png';
import SiteJsonLd from './SiteJsonLd.astro';
import { GITHUB_URL, getStarCount, formatStarCount } from '../data/github-stars';


const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = base;

const t = (en: string, ..._translations: string[]): string => en;

const starCount = await getStarCount();
const starLocale = 'en';
const githubCta = t('Star on GitHub');
const starLabel = t('Star on GitHub, {count} stars');
const githubAccessibleName = starCount === null ? githubCta
	: starLabel.replace('{count}', new Intl.NumberFormat(starLocale).format(starCount));

const icons: Record<string, string> = {
	// Lucide outline paths (24x24, stroke)
	plug: 'M12 22v-5M9 8V2M15 8V2M6 8h12l-1 6a5 5 0 0 1-10 0Z',
	key: 'M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777Zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4',
	users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
	picker: 'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Zm6-2v18M3 9h6',
	bot: 'M12 8V4H8m8 0h-4M4 12a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Zm11 3h.01M9 15h.01M2 14h2m16 0h2',
	search: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35',
	rocket: 'M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09ZM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Zm-3-3H4s.55-3.03 2-4c1.62-1.08 5 0 5 0m0 9v5s3.03-.55 4-2c1.08-1.62 0-5 0-5',
	book: 'M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20',
	code: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
	terminal: 'M4 17l6-6-6-6M12 19h8',
	folder: 'M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z',
	// Windows four-pane mark (not in simple-icons); fill, not stroke
	windows: 'M3 3h8.5v8.5H3Zm9.5 0H21v8.5h-8.5ZM3 12.5h8.5V21H3Zm9.5 0H21V21h-8.5Z',
	// Lucide download glyph (arrow into a tray); stroke, not fill
	download: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3',
};

// Official monochrome marks from simple-icons where the brand exists in the
// library; brands missing from it stay text-only (no generic substitutes).
const providers: { label: string; path?: string }[] = [
	{ label: 'Anthropic', path: siAnthropic.path },
	{ label: 'Google', path: siGoogle.path },
	{ label: 'xAI' },
	{ label: 'Kimi', path: siMoonshotai.path },
	{ label: 'Ollama Cloud', path: siOllama.path },
	{ label: 'Groq' },
	{ label: 'OpenRouter', path: siOpenrouter.path },
	{ label: 'Azure' },
	{ label: 'DeepSeek', path: siDeepseek.path },
	{ label: 'GLM' },
];

const quickstartMini = [
	{ cmd: 'npm install -g @bitkyc08/opencodex', note: t('Install') },
	{ cmd: 'ocx start', note: t('Start the proxy') },
];

const quickstart = [
	{ cmd: 'npm install -g @bitkyc08/opencodex', note: t('Install') },
	{ cmd: 'ocx init', note: t('Inject a provider into Codex') },
	{ cmd: 'ocx start', note: t('Start the proxy') },
	{ cmd: 'codex "Write a hello world in Rust"', note: t('Codex now routes through ocx') },
];

// full docs map for the closing sitemap band (also the mobile path to every section)
const docsMap = [
	{
		label: t('Getting Started'),
		icon: 'rocket',
		links: [
			{ label: t('Installation'), href: `${prefix}getting-started/installation/` },
			{ label: t('Desktop App'), href: `${prefix}guides/desktop-app/` },
			{ label: t('Quickstart'), href: `${prefix}getting-started/quickstart/` },
			{ label: t('How It Works'), href: `${prefix}getting-started/how-it-works/` },
			{ label: t('Agent Quickstart'), href: `${prefix}getting-started/for-agents/` },
		],
	},
	{
		label: t('Guides'),
		icon: 'book',
		links: [
			{ label: t('Providers'), href: `${prefix}guides/providers/` },
			{ label: t('Model Routing'), href: `${prefix}guides/model-routing/` },
			{ label: t('Combos'), href: `${prefix}guides/combos/` },
			{ label: t('Codex Integration'), href: `${prefix}guides/codex-integration/` },
			{ label: t('Codex App Model Picker'), href: `${prefix}guides/codex-app-models/` },
			{ label: 'Claude Code', href: `${prefix}guides/claude-code/` },
			{ label: t('Sidecars: Search & Vision'), href: `${prefix}guides/sidecars/` },
			{ label: t('Image Bridge'), href: `${prefix}guides/image-bridge/` },
			{ label: t('Video Bridge'), href: `${prefix}guides/video-bridge/` },
			{ label: t('Web Dashboard'), href: `${prefix}guides/web-dashboard/` },
			{ label: t('Sub-agent Surface'), href: `${prefix}guides/sub-agent-surface/` },
		],
	},
	{
		label: t('Reference'),
		icon: 'code',
		links: [
			{ label: 'CLI', href: `${prefix}reference/cli/` },
			{ label: t('Configuration'), href: `${prefix}reference/configuration/` },
			{ label: t('Adapters'), href: `${prefix}reference/adapters/` },
			{ label: t('Architecture'), href: `${prefix}reference/architecture/` },
			{ label: t('Proxy API Formats'), href: `${prefix}reference/proxy-formats/` },
			{ label: t('Management API'), href: `${prefix}reference/management-api/` },
		],
	},
	{
		label: t('Project'),
		icon: 'folder',
		links: [
			{ label: t('Contributing'), href: `${prefix}contributing/` },
			{ label: 'GitHub', href: 'https://github.com/lidge-jun/opencodex' },
			{ label: 'npm', href: 'https://www.npmjs.com/package/@bitkyc08/opencodex' },
		],
	},
];
---

{/* Site-name markup: Landing only renders on the locale home pages, so this is
    the one place Google should see a WebSite entity. */}
<SiteJsonLd />

<div class="lp not-content">
	<!-- scene stack: hero -> quickstart -> horizontal rail. Each wrapper owns a
	     named view-timeline; its sticky inner stage pins under the pill header
	     while the next scene rides over it (motion.md sticky stacking +
	     scale-depth morph). -->
	<div class="lp-scenes">
	<section class="lp-scene lp-scene-hero">
	<div class="lp-scene-inner lp-hero-field">
		<div class="lp-field-bg" aria-hidden="true">
			<Image src={heroFieldLight} alt="" class="lp-field-light" loading="eager" widths={[1024, 2048]} sizes="100vw" />
			<Image src={heroFieldDark} alt="" class="lp-field-dark" loading="lazy" widths={[1024, 2048]} sizes="100vw" />
		</div>
		<div class="lp-hero-copy">
			<a class="lp-announce" href="#download">
				<span class="lp-announce-text">{t('Desktop beta')}</span>
				<svg viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</a>
			{/* Product-word drum: the H1 performs the claim — the proxy serves both
			    Codex and Claude Code. 4-face rotateX cylinder, fixed slot width via
			    inline-grid stacking; reduced-motion collapses to a static pairing. */}
			<h1 id="_top">
				{t('Run ')}<span class="lp-drum" aria-label="Codex and Claude">
					<span class="lp-drum-spin" aria-hidden="true">
						<span class="lp-drum-face lp-drum-codex">Codex</span>
						<span class="lp-drum-face lp-drum-claude">Claude</span>
						<span class="lp-drum-face lp-drum-codex">Codex</span>
						<span class="lp-drum-face lp-drum-claude">Claude</span>
					</span>
					<span class="lp-drum-static" aria-hidden="true">Codex<span class="lp-drum-dot"> · </span>Claude</span>
				</span>{t(' on any LLM.')}
			</h1>
			<p class="lp-sub">
				{t('opencodex is a local proxy that serves Codex and Claude Code from one port — translating each wire format to any provider, with streaming, tool calls, reasoning, and images in both directions. Zero client patches.')}
			</p>
			<div class="lp-cta">
				<a class="lp-btn-primary" id="lp-hero-download" href="#download"
					data-label-macos={t('Download for macOS')}
					data-label-windows={t('Download for Windows')}
					data-label-linux={t('Download for Linux')}>
					<span id="lp-hero-download-label">{t('Download')}</span>
					<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</a>
				<a class="lp-btn-ghost" href={`${prefix}getting-started/installation/`}>{t('Get Started')}</a>
			</div>
		<ul class="lp-chips" aria-label={t('Supported providers')}>
				{providers.map((p) => (
					<li>
						{p.path && (
							<svg class="lp-chip-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={p.path} />
							</svg>
						)}
						{p.label}
					</li>
				))}
				<li class="lp-chip-more"><a href={`${prefix}guides/providers/`}>{t('40+ providers')}</a></li>
			</ul>
		</div>
		<div class="lp-stage-in">
			<Image src={dashboard} alt={t('The opencodex dashboard — live proxy status, routed providers, and available models')} loading="eager" />
		</div>
	</div>
	</section>

	<!-- download sheet: real asset URLs resolved client-side from the latest
	     GitHub release; every href falls back to releases/latest so the
	     section stays useful with JS off or the API rate-limited. -->
	<section class="lp-download" id="download">
		<h2 class="lp-download-title">{t('Download OpenCodex')}</h2>
		<p class="lp-download-sub">{t('The desktop app bundles the proxy, the dashboard and a tray. Beta.')}</p>
		<p class="lp-download-version"><span data-lp-version-wrap hidden>{t('Latest release')} <span data-lp-version></span></span></p>
		<div class="lp-dl-grid">
			<article class="lp-dl-card" data-platform="macos">
				<svg class="lp-dl-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siApple.path} /></svg>
				<h3>macOS</h3>
				<p class="lp-dl-meta">{t('Universal · Apple Silicon and Intel · macOS 13+ · .dmg')}</p>
				<div class="lp-dl-actions">
					<a class="lp-dl-btn" data-lp-asset="dmg" href="https://github.com/lidge-jun/opencodex/releases/latest"><svg class="lp-dl-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.download} /></svg>{t('Download')}<span class="lp-dl-btn-fmt">.dmg</span></a>
				</div>
				<p class="lp-dl-reco">{t('Recommended for your system')}</p>
			</article>
			<article class="lp-dl-card" data-platform="windows">
				<svg class="lp-dl-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons.windows} /></svg>
				<h3>Windows</h3>
				<p class="lp-dl-meta">x64 · .msi</p>
				<p class="lp-dl-note">{t('Installer not code-signed yet')}</p>
				<div class="lp-dl-actions">
					<a class="lp-dl-btn" data-lp-asset="msi" href="https://github.com/lidge-jun/opencodex/releases/latest"><svg class="lp-dl-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.download} /></svg>{t('Download')}<span class="lp-dl-btn-fmt">.msi</span></a>
				</div>
				<p class="lp-dl-reco">{t('Recommended for your system')}</p>
			</article>
			<article class="lp-dl-card" data-platform="linux">
				<svg class="lp-dl-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={siLinux.path} /></svg>
				<h3>Linux</h3>
				<p class="lp-dl-meta">x86_64 · .AppImage</p>
				<div class="lp-dl-actions">
					<a class="lp-dl-btn" data-lp-asset="appimage" href="https://github.com/lidge-jun/opencodex/releases/latest"><svg class="lp-dl-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.download} /></svg>{t('Download')}<span class="lp-dl-btn-fmt">.AppImage</span></a>
					<a class="lp-dl-alt" data-lp-asset="deb" href="https://github.com/lidge-jun/opencodex/releases/latest">{t('.deb package')}</a>
				</div>
				<p class="lp-dl-reco">{t('Recommended for your system')}</p>
			</article>
		</div>
		<details class="lp-dl-more" hidden>
			<summary>{t('Other platforms')}</summary>
			<div class="lp-dl-more-grid"></div>
		</details>
		<p class="lp-dl-foot">
			{t('Prefer the terminal?')}
			<code>npm install -g @bitkyc08/opencodex</code>
			<a href={`${prefix}getting-started/installation/`}>{t('Installation guide')}</a>
			<a href="https://github.com/lidge-jun/opencodex/releases/latest">{t('All releases and checksums')}</a>
			<a href={`${prefix}guides/desktop-app/`}>{t('Desktop app guide')}</a>
		</p>
		<!-- SignPath Foundation's terms require this attribution, verbatim, and the code signing
		     policy link on the download page; the policy page exists in English only. -->
		<p class="lp-dl-foot">
			<span>Free code signing provided by <a href="https://about.signpath.io/">SignPath.io</a>, certificate by <a href="https://signpath.org/">SignPath Foundation</a>.</span>
			<a href={`${base}reference/code-signing/`}>{t('Code signing policy')}</a>
		</p>
	</section>

	<!-- quickstart sheet scene -->
	<section class="lp-scene lp-scene-quick">
	<div class="lp-scene-inner lp-quick">
		<div class="lp-kinetic" aria-label={t('Install. Start. Codex, rerouted.')}>
			<p class="lp-kline">{t('Install.')}</p>
			<p class="lp-kline">{t('Start.')}</p>
			<p class="lp-kline lp-kline-accent">{t('Codex, rerouted.')}</p>
		</div>
		<div class="lp-quick-side">
			<div class="lp-terminal">
				<div class="lp-terminal-bar"><span>zsh</span></div>
				<pre>{quickstartMini.map((line) => (<code><span class="lp-prompt">$ </span>{line.cmd}<span class="lp-note">  # {line.note}</span>{'\n'}</code>))}</pre>
			</div>
			<a class="lp-inline-link" href={`${prefix}getting-started/quickstart/`}>{t('Full quickstart')} →</a>
		</div>
	</div>
	</section>

	<!-- demo scrub: the capture plays through, driven by scroll -->
	<section class="lp-scene lp-scene-scrub">
	<div class="lp-scene-inner lp-scrub">
		<h2 class="lp-scrub-title">{t('Watch Codex run on a routed model.')}</h2>
		<div class="lp-scrub-stage">
			<canvas class="lp-scrub-canvas" data-base={base} data-count="158" width="900" height="802" aria-label={t('Codex App running a task on a routed non-OpenAI model')}></canvas>
			<Image src={demo} alt={t('Codex App running a task on a routed non-OpenAI model')} loading="lazy" class="lp-scrub-poster" />
		</div>
		<p class="lp-scrub-caption">{t('One task, streamed end to end through opencodex.')}</p>
	</div>
	</section>
	</div>

	<!-- feature bento: dominant cell + content-weighted spans -->
	<section class="lp-bento">
		<h2 class="lp-bento-title">{t('One proxy, the whole surface.')}</h2>
		<div class="lp-grid">
			<article class="lp-cell lp-cell-providers">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.plug} /></svg>{t('Any provider')}</h3>
				<p>
					{t('Five adapters cover Anthropic Messages, Google Gemini, Azure, the OpenAI Responses passthrough, and every OpenAI-compatible Chat Completions endpoint — 40+ built-in providers.')}
				</p>
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.key} /></svg>{t('OAuth or API key')}</h3>
				<p>{t('Log in with your xAI, Anthropic, or Kimi account — auto-refreshed — forward your ChatGPT login, or paste a key.')}</p>
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.users} /></svg>{t('ChatGPT account pool')}</h3>
				<p>{t('Existing threads keep their account; new sessions auto-route to the lowest-usage healthy one after quota refresh.')}</p>
			</article>
			<article class="lp-cell lp-cell-picker">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.picker} /></svg>{t('Native in the model picker')}</h3>
				<p>{t('Routed models show up in Codex App with reasoning effort levels, next to the native ones.')}</p>
				<Image src={picker} alt={t('Codex App model picker with reasoning effort levels')} loading="lazy" />
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.bot} /></svg>{t('Sub-agents')}</h3>
				<p>{t('Pin up to five routed or native models for Codex spawn_agent, and switch the v1 / base / v2 surface globally.')}</p>
			</article>
			<article class="lp-cell lp-cell-claude">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.terminal} /></svg>Claude Code</h3>
				<p>{t('ocx claude launches Claude Code against the same port — every routed model in the /model picker, auto-context up to 1M, roster sub-agents, and your claude.ai login stays active.')}</p>
				<img width="960" height="874" src={`${base}claude-code-models.gif`} alt={t('Claude Code running a routed model through opencodex — gpt-5.6-luna-medium active in the status bar')} loading="lazy" />
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.search} /></svg>{t('Search & vision sidecars')}</h3>
				<p>{t('Give non-OpenAI models real web search and image understanding through a gpt-5.6-luna sidecar.')}</p>
			</article>
			<article class="lp-cell lp-cell-terminal">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.code} /></svg>{t('Quickstart')}</h3>
				<p>{t('ocx init writes a provider into your Codex config and shares one model catalog with Codex CLI, TUI, App, and SDK. ocx stop restores native Codex cleanly.')}</p>
				<div class="lp-terminal">
					<div class="lp-terminal-bar"><span>zsh</span></div>
					<pre>{quickstart.map((line) => (<code><span class="lp-prompt">$ </span>{line.cmd}<span class="lp-note">  # {line.note}</span>{'\n'}</code>))}</pre>
				</div>
			</article>
		</div>
	</section>

	<div class="lp-github-row">
		<a class="lp-github-cta" href={GITHUB_URL} aria-label={githubAccessibleName}
			data-gh-stars-label={starLabel} data-gh-stars-locale={starLocale}>
			<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
			<span>{githubCta}</span>
			{starCount !== null && <span data-gh-stars={starCount}>{formatStarCount(starCount)}</span>}
		</a>
	</div>

	<!-- full docs sitemap band: every section reachable from the landing -->
	<section class="lp-next" aria-label={t('Documentation map')}>
		<h2>{t('Explore the docs')}</h2>
		<div class="lp-next-grid">
			{docsMap.map((group) => (
				<div class="lp-next-col">
					<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[group.icon]} /></svg>{group.label}</h3>
					<ul>
						{group.links.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<p class="lp-disclaimer">
		{t(
			'opencodex is an independent community project, not affiliated with or endorsed by OpenAI, Anthropic, or any other provider. Some providers may restrict accounts that route traffic through third-party proxies — review each provider\u2019s Terms of Service before connecting.')}
	</p>
</div>

<script>
	// Frame-sequence scrub (motion.md): the demo capture plays through as the
	// scrub scene scrolls. Short-circuits under reduced motion / small screens
	// (the animated poster stays); progressive checkpoint loading.
	const canvas = document.querySelector<HTMLCanvasElement>('.lp-scrub-canvas');
	const section = document.querySelector<HTMLElement>('.lp-scene-scrub');
	const poster = document.querySelector<HTMLImageElement>('.lp-scrub-poster');
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const wide = matchMedia('(min-width: 48rem)').matches;
	if (canvas && section && poster && !reduce && wide) {
		const ctx = canvas.getContext('2d');
		const count = Number(canvas.dataset.count || '0');
		const base = canvas.dataset.base || '/';
		const url = (i: number) => `${base}demo-frames/${String(i + 1).padStart(3)}.webp`;
		const frames: (HTMLImageElement | undefined)[] = new Array(count);
		let started = false;
		let current = -1;
		let raf = 0;
		const load = (i: number) =>
			new Promise<void>((resolve) => {
				if (frames[i]) return resolve();
				const img = new Image();
				img.onload = () => { frames[i] = img; resolve(); };
				img.onerror = () => resolve();
				img.src = url(i);
			});
		const nearestLoaded = (i: number) => {
			for (let d = 0; d < count; d++) {
				if (frames[i - d]?.complete) return i - d;
				if (frames[i + d]?.complete) return i + d;
			}
			return -1;
		};
		const draw = (i: number) => {
			const j = nearestLoaded(Math.max(0, Math.min(count - 1, i)));
			if (j < 0 || j === current || !ctx) return;
			current = j;
			const img = frames[j]!;
			if (canvas.width !== img.naturalWidth) {
				canvas.width = img.naturalWidth;
				canvas.height = img.naturalHeight;
			}
			ctx.clearRect(0);
			ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
			poster.style.display = 'none';
			canvas.style.display = 'block';
		};
		const update = () => {
			raf = 0;
			const rect = section.getBoundingClientRect();
			const travel = section.offsetHeight - innerHeight;
			if (travel <= 0) return;
			const progress = Math.min(1, Math.max(0, -rect.top / travel));
			draw(Math.round(progress * (count - 1)));
		};
		const start = async () => {
			if (started) return;
			started = true;
			await load(0);
			draw(0);
			// checkpoints first, then fill in idle time
			const checkpoints = [count - 1, Math.floor(count / 2), Math.floor(count / 4), Math.floor((3 * count) / 4)];
			await Promise.all(checkpoints.map(load));
			update();
			const fill = (i: number) => {
				if (i >= count) return;
				load(i).then(() => {
					const next = () => fill(i + 1);
					'requestIdleCallback' in window ? requestIdleCallback(next) : setTimeout(next);
				});
			};
			fill(0);
			addEventListener('scroll', () => { raf ||= requestAnimationFrame(update); }, { passive: true });
			addEventListener('resize', () => { raf ||= requestAnimationFrame(update); }, { passive: true });
		};
		new IntersectionObserver((entries, obs) => {
			if (entries.some((e) => e.isIntersecting)) { obs.disconnect(); start(); }
		}, { rootMargin: '100% 0px' }).observe(section);
	}
</script>

<script>
	// Desktop download surface: platform detection upgrades the hero CTA label
	// and flags the matching card; the latest-release fetch then swaps each
	// placeholder href for the real asset URL. Every step is optional — a
	// missing element, a failed fetch or a rate limit leaves the
	// server-rendered defaults (releases/latest) untouched.
	const uaPlatform = (navigator as Navigator & { userAgentData?: { platform?: string } })
		.userAgentData?.platform || navigator.userAgent || '';
	// Phones, tablets and ChromeOS cannot run the desktop builds; iOS user agents
	// also say "like Mac OS X", so they are ruled out before the desktop tests.
	// iPadOS in desktop mode reports a Mac user agent; a touch screen gives it away.
	const handheld = /iphone|ipad|ipod|android|cros|mobile/i.test(`${uaPlatform} ${navigator.userAgent}`)
		|| (/mac/i.test(uaPlatform) && navigator.maxTouchPoints > 1);
	const platform = handheld
		? ''
		: /mac/i.test(uaPlatform)
		? 'macos'
		: /win/i.test(uaPlatform)
			? 'windows'
			: /linux|x11/i.test(uaPlatform)
				? 'linux'
				: '';
	const recommend = (platform: string) => {
		const heroLabel = document.getElementById('lp-hero-download-label');
		const heroBtn = document.getElementById('lp-hero-download');
		const label = heroBtn?.dataset[`label${platform[0].toUpperCase()}${platform.slice(1)}`];
		if (heroLabel && label) heroLabel.textContent = label;
		const card = document.querySelector<HTMLElement>(`.lp-dl-card[data-platform="${platform}"]`);
		if (!card) return;
		card.setAttribute('data-recommended', '');
		// Show only this platform's card; the others move into the disclosure.
		// Without detection (or JavaScript) all three stay in the grid.
		const more = document.querySelector<HTMLDetailsElement>('.lp-dl-more');
		const moreGrid = more?.querySelector<HTMLElement>('.lp-dl-more-grid');
		if (!more || !moreGrid) return;
		document
			.querySelectorAll<HTMLElement>('.lp-dl-grid .lp-dl-card:not([data-recommended])')
			.forEach((other) => moreGrid.append(other));
		more.hidden = false;
	};
	// Linux builds are x86_64 only, so an ARM Linux desktop gets no recommendation.
	// Chromium freezes the Linux user agent to "x86_64", so its architecture hint
	// wins when present; other browsers report the real machine in the user agent.
	const uaData = (navigator as Navigator & {
		userAgentData?: { getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }> };
	}).userAgentData;
	if (platform === 'linux') {
		if (uaData?.getHighEntropyValues) {
			uaData
				.getHighEntropyValues(['architecture'])
				.then((hints) => { if (hints.architecture === 'x86') recommend('linux'); })
				.catch(() => {});
		} else if (/x86_64|amd64|x64/i.test(navigator.userAgent)) {
			recommend('linux');
		}
	} else if (platform) {
		recommend(platform);
	}
	fetch('https://api.github.com/repos/lidge-jun/opencodex/releases/latest')
		.then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
		.then((release: { tag_name?: string; assets?: { name?: string; browser_download_url?: string }[] }) => {
			const patterns: Record<string, RegExp> = {
				dmg: /-macos\.dmg$/,
				msi: /-windows-x64\.msi$/,
				appimage: /-linux-x86_64\.AppImage$/,
				deb: /-linux-amd64\.deb$/,
			};
			for (const asset of release.assets ?? []) {
				const key = Object.keys(patterns).find((k) => asset.name && patterns[k].test(asset.name));
				if (!key || !asset.browser_download_url) continue;
				const link = document.querySelector<HTMLAnchorElement>(`[data-lp-asset="${key}"]`);
				if (link) link.href = asset.browser_download_url;
			}
			const version = document.querySelector<HTMLElement>('[data-lp-version]');
			if (version && release.tag_name) {
				version.textContent = release.tag_name;
				version.closest('[data-lp-version-wrap]')?.removeAttribute('hidden');
			}
		})
		.catch(() => {});
</script>
